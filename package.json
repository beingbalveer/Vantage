{
  "name": "vantage",
  "private": true,
  "version": "0.3.0",
  "description": "A lightweight multi-repo Git desktop client, read-only code viewer, and terminal workspace",
  "author": "Balveer Dhanoriya <https://github.com/beingbalveer>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beingbalveer/vantage.git"
  },
  "bugs": {
    "url": "https://github.com/beingbalveer/vantage/issues"
  },
  "homepage": "https://github.com/beingbalveer/vantage#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:bundle": "tauri build --debug --config src-tauri/tauri.dev.conf.json",
    "build": "vite build",
    "build:dev": "VITE_DEV_BUILD=1 vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint:design": "node scripts/design-guard.mjs",
    "lint:layers": "node scripts/check-layers.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.10.0",
    "lucide-svelte": "^0.460.0",
    "marked": "^18.1.2"
  },
  "packageManager": "npm@11.19.1"
}
