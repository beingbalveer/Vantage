{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage",
  "version": "0.1.0",
  "identifier": "io.github.beingbalveer.vantage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vantage",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 17
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Balveer Dhanoriya",
    "category": "DeveloperTool",
    "shortDescription": "Lightweight multi-repo Git client and code review deck",
    "longDescription": "A lightweight multi-repo Git desktop client, read-only code viewer, and terminal workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
