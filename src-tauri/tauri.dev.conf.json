{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage Dev",
  "app": {
    "windows": [
      {
        "title": "Vantage Dev",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "npm run build:dev"
  }
}
